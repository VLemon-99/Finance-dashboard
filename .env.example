# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it. This example file contains placeholders only.

# Gemini API key from Google AI Studio (https://aistudio.google.com) — for AI summaries in reports.
# Leave the placeholder to run reports without AI. Steps: README, "Setting up reports".
GEMINI_API_KEY=your-gemini-key-here

# FRED API key (free) — for the calendar's CPI, jobs report, PCE and GDP dates.
# Leave the placeholder and those show as missing. Steps: README, "Setting up the calendar".
FRED_API_KEY=your-fred-key-here

# SEC EDGAR requires a contact in every request: your name and email, e.g. "Jane Doe jane@yourmail.com".
# Sent only to the SEC. While this placeholder is here, reports skip SEC filings.
SEC_USER_AGENT=Your Name your-email@example.com
