# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored — never commit it. This example file contains placeholders only.

# Gemini API key from Google AI Studio (https://aistudio.google.com) — needed from Phase 3
GEMINI_API_KEY=your-gemini-key-here

# FRED API key (free, https://fred.stlouisfed.org/docs/api/api_key.html) — needed from Phase 6
FRED_API_KEY=your-fred-key-here

# SEC EDGAR requires a contact string in every request: "Your Name your-email@example.com"
SEC_USER_AGENT=Your Name your-email@example.com
